# Race intake (RaceTrace 2.0, G4). Copy to server/.env.intake (git-ignored) on
# the machine that runs the racetrace-ingest skill. Never commit the real file.

# RaceTrace API (production: the Railway API host). "/api" is added if missing.
RACETRACE_API_URL=https://your-api-host.example.com

# Admin → API Tokens → Create token (scope "intake"). Shown once; paste it here.
RACETRACE_API_TOKEN=rt_paste_the_token_here

# Speedhive organisation id of WRL, for 2025 WRL races (`intake discover --series wrl-speedhive`).
# WRL from 2026 comes from RedMist (`--series wrl`) and needs no setting.
# Find it once with: npx tsx scripts/intake.ts speedhive-org --from-session <any WRL session URL>
SPEEDHIVE_WRL_ORG_ID=

# Optional
# INTAKE_WORK_DIR=C:\RaceTrace\intake-work
# INTAKE_DELAY_MS=500
# INTAKE_REDMIST_GAP_MS=1600
# INTAKE_USER_AGENT=RaceTrace-Intake/1.0 (+https://racetrace.tedderengineering.com)
