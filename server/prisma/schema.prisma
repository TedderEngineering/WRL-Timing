generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionPlan {
  FREE
  PRO
  TEAM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  INCOMPLETE
}

enum RaceStatus {
  DRAFT
  PUBLISHED
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String    @map("password_hash")
  displayName    String?   @map("display_name")
  avatarUrl      String?   @map("avatar_url")
  emailVerified  Boolean   @default(false) @map("email_verified")
  role           UserRole  @default(USER)
  suspendedAt    DateTime? @map("suspended_at")
  lastLoginAt    DateTime? @map("last_login_at")
  onboardingDone Boolean   @default(false) @map("onboarding_done")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens   EmailVerificationToken[]
  subscription        Subscription?
  preferences         UserPreferences?
  favorites           UserFavorite[]
  raceViews           UserRaceView[]
  createdRaces        Race[]                   @relation("RaceCreator")
  createdQualifyingSessions QualifyingSession[] @relation("QualifyingCreator")
  auditLogs           AuditLog[]

  gripAccount            GripAccount?
  gripReferenceSessions  GripReferenceSession[]
  gripCalculations       GripCalculation[]

  setupMemberships       SetupTeamMember[]
  setupTeamsCreated      SetupTeam[]          @relation("SetupTeamCreator")
  setupInvitesSent       SetupInvite[]        @relation("SetupInviteSender")
  setupSheetsUpdated     SetupSheet[]         @relation("SetupSheetEditor")
  setupSheetRevisions    SetupSheetRevision[]
  setupSessionNotes      SetupSessionNote[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  /// Set when this token was exchanged for a new one. Honoured for a short
  /// grace window so concurrent refreshes don't look like token theft.
  rotatedAt DateTime? @map("rotated_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("email_verification_tokens")
}

// ─── Subscriptions ────────────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique @map("user_id")
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─── Events ──────────────────────────────────────────────────────────────────

model Event {
  id              String     @id @default(cuid())
  name            String
  series          String
  sanctioningBody String     @default("SRO") @map("sanctioning_body")
  track           String
  date            DateTime // event start date
  season          String // e.g. "2025"
  status          RaceStatus @default(PUBLISHED)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  races                Race[]
  qualifyingSessions   QualifyingSession[]

  @@index([series, track, date])
  @@index([sanctioningBody])
  @@index([status])
  @@index([date(sort: Desc)])
  @@map("events")
}

// ─── Race Data ────────────────────────────────────────────────────────────────

model Race {
  id              String     @id @default(cuid())
  name            String
  date            DateTime
  track           String
  series          String
  sanctioningBody String     @default("SRO") @map("sanctioning_body")
  season          Int
  status          RaceStatus @default(DRAFT)
  premium        Boolean    @default(false)
  maxLap         Int?       @map("max_lap")
  totalCars      Int?       @map("total_cars")
  createdBy      String     @map("created_by")
  eventId        String?    @map("event_id")
  subSeries      String?    @map("sub_series") // e.g. "WeatherTech", "Pilot Challenge"
  roundNumber    Int?       @map("round_number") // per sub_series per season
  sourceFiles    Json?      @map("source_files") // Supabase Storage paths for raw uploaded files
  chartData      Json?      @map("chart_data") // full DATA object for chart rendering
  annotationData Json?      @map("annotation_data") // full ANN object for chart rendering
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  creator   User           @relation("RaceCreator", fields: [createdBy], references: [id])
  event     Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  entries          RaceEntry[]
  laps             RaceLap[]
  favorites        UserFavorite[]
  views            UserRaceView[]
  pitStopAnalysis  PitStopAnalysis[]

  @@index([status])
  @@index([series, season])
  @@index([sanctioningBody])
  @@index([date(sort: Desc)])
  @@index([eventId])
  @@map("races")
}

model RaceEntry {
  id             String  @id @default(cuid())
  raceId         String  @map("race_id")
  carNumber      String  @map("car_number")
  teamName       String  @map("team_name")
  driverNames    String  @map("driver_names") // comma-separated or JSON
  carClass       String  @map("car_class")
  carColor       String? @map("car_color") // hex color for chart rendering
  finishPos      Int?    @map("finish_pos")
  finishPosClass Int?    @map("finish_pos_class")
  lapsCompleted  Int?    @map("laps_completed")

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([raceId, carNumber])
  @@index([raceId])
  @@map("race_entries")
}

model RaceLap {
  id               String  @id @default(cuid())
  raceId           String  @map("race_id")
  carNumber        String  @map("car_number")
  lapNumber        Int     @map("lap_number")
  position         Int // overall position
  classPosition    Int?    @map("class_position") // in-class position
  lapTimeFormatted String? @map("lap_time_formatted") // "M:SS.mmm"
  lapTimeSec       Float?  @map("lap_time_sec") // seconds as decimal
  lapTimeMs        Int?    @map("lap_time_ms")
  cumulativeTimeMs BigInt? @map("cumulative_time_ms")
  gapToLeaderMs    Int?    @map("gap_to_leader_ms")
  intervalMs       Int?    @map("interval_ms")
  flag             String? // "GF" or "FCY"
  speed            Float? // mph
  pitStop          Boolean @default(false) @map("pit_stop")
  inLap            Boolean @default(false) @map("in_lap")
  outLap           Boolean @default(false) @map("out_lap")

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([raceId, lapNumber, position])
  @@index([raceId, carNumber])
  @@map("race_laps")
}

// ─── User Preferences & Activity ──────────────────────────────────────────────

model UserFavorite {
  userId    String   @map("user_id")
  raceId    String   @map("race_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@id([userId, raceId])
  @@map("user_favorites")
}

model UserRaceView {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  raceId   String   @map("race_id")
  viewedAt DateTime @default(now()) @map("viewed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt(sort: Desc)])
  @@index([raceId])
  @@map("user_race_views")
}

model UserPreferences {
  userId               String @id @map("user_id")
  theme                String @default("system") // "light" | "dark" | "system"
  defaultChartSettings Json?  @map("default_chart_settings")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ─── Admin ────────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String   @map("admin_user_id")
  action      String // e.g., "DELETE_RACE", "SUSPEND_USER", "PROMOTE_ADMIN"
  targetType  String   @map("target_type") // e.g., "race", "user"
  targetId    String   @map("target_id")
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminUserId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([adminUserId])
  @@map("audit_log")
}

// ─── Qualifying Sessions ─────────────────────────────────────────────────────

model QualifyingSession {
  id          String     @id @default(cuid())
  name        String                          // e.g. "Qualify 2 — Barber 2026"
  sessionName String     @map("session_name") // e.g. "Qualify 2"
  date        DateTime
  track       String
  series      String                          // "SRO GT4 America", "Toyota GR Cup", "IMSA"
  season      Int
  status      RaceStatus @default(DRAFT)
  chartData   Json?      @map("chart_data")   // QualifyingChartData blob
  createdBy   String     @map("created_by")
  eventId     String?    @map("event_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  creator User  @relation("QualifyingCreator", fields: [createdBy], references: [id])
  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([series, season])
  @@index([date(sort: Desc)])
  @@index([eventId])
  @@map("qualifying_sessions")
}

// ─── Pit Stop Analysis ──────────────────────────────────────────────────────

model TrackPitConfig {
  id                String   @id @default(cuid())
  trackName         String   @map("track_name")
  series            String
  eventYear         Int?     @map("event_year")
  speedLimitMps     Float    @map("speed_limit_mps")
  driveThrough_s    Float?   @map("drive_through_s")
  pitRoadLength_m   Float    @map("pit_road_length_m")
  transitTime_s     Float    @map("transit_time_s")
  transitOverhead_s Float    @map("transit_overhead_s")
  source            String
  isOfficial        Boolean  @default(false) @map("is_official")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([trackName, series, eventYear])
  @@map("track_pit_configs")
}

model PitStopAnalysis {
  id                    String   @id @default(cuid())
  raceId                String   @map("race_id")
  carNumber             String   @map("car_number")
  stopNumber            Int      @map("stop_number")
  pitLap                Int      @map("pit_lap")
  condition             String
  localRef_s            Float    @map("local_ref_s")
  vsGlobal_s            Float    @map("vs_global_s")
  refSource             String   @map("ref_source")
  twoLapActual_s        Float    @map("two_lap_actual_s")
  twoLapRef_s           Float    @map("two_lap_ref_s")
  serviceTime_s         Float    @map("service_time_s")
  pitRoadTime_s         Float    @map("pit_road_time_s")
  timeLost_s            Float    @map("time_lost_s")
  delta_s               Float    @map("delta_s")
  isCautionContaminated Boolean  @default(false) @map("is_caution_contaminated")
  createdAt             DateTime @default(now()) @map("created_at")

  race Race @relation(fields: [raceId], references: [id], onDelete: Cascade)

  @@unique([raceId, carNumber, stopNumber])
  @@index([raceId])
  @@map("pit_stop_analysis")
}

// ─── Finding Grip ─────────────────────────────────────────────────────────────
// Tire pressure and damper tools. Shares users, auth and the Stripe customer
// with RaceTrace; everything else lives in grip_* tables.
//
// Pressures are stored in PSI and temperatures in °F. The client converts for
// display. The calculation model and the damper table contents are NOT in this
// repository: the model is read from the GRIP_CALC_MODEL environment variable
// and the damper rows are loaded through the admin import endpoint.

enum GripPlan {
  FREE
  PRO
}

enum GripUnits {
  STANDARD
  METRIC
}

enum GripWeather {
  DRY
  WET
}

model GripAccount {
  userId               String             @id @map("user_id")
  units                GripUnits          @default(STANDARD)
  plan                 GripPlan           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  // Lifetime count of calculations run. The free-tier limit uses this, so
  // deleting a calculation does not hand the allowance back.
  calcCount            Int                @default(0) @map("calc_count")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("grip_accounts")
}

model GripTrack {
  id        String   @id @default(cuid())
  name      String   @unique
  shortName String   @map("short_name")
  country   String?
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  referenceSessions GripReferenceSession[]
  calculations      GripCalculation[]

  @@map("grip_tracks")
}

model GripReferenceSession {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  name        String
  trackId     String      @map("track_id")
  sessionDate DateTime    @default(now()) @map("session_date")
  weather     GripWeather @default(DRY)
  trackTemp   Float       @map("track_temp")
  ambientTemp Float       @map("ambient_temp")
  durationMin Int         @map("duration_min")
  coldLf      Float       @map("cold_lf")
  coldRf      Float       @map("cold_rf")
  coldLr      Float       @map("cold_lr")
  coldRr      Float       @map("cold_rr")
  hotLf       Float?      @map("hot_lf")
  hotRf       Float?      @map("hot_rf")
  hotLr       Float?      @map("hot_lr")
  hotRr       Float?      @map("hot_rr")
  wheelLf     Float       @map("wheel_lf")
  wheelRf     Float       @map("wheel_rf")
  wheelLr     Float       @map("wheel_lr")
  wheelRr     Float       @map("wheel_rr")
  notes       String?
  useCount    Int         @default(0) @map("use_count")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  track        GripTrack         @relation(fields: [trackId], references: [id])
  calculations GripCalculation[]

  @@index([userId, sessionDate(sort: Desc)])
  @@map("grip_reference_sessions")
}

model GripCalculation {
  id                 String      @id @default(cuid())
  userId             String      @map("user_id")
  referenceSessionId String?     @map("reference_session_id")
  referenceName      String      @map("reference_name")
  trackId            String      @map("track_id")
  name               String
  sessionDate        DateTime    @default(now()) @map("session_date")
  weather            GripWeather
  trackTemp          Float       @map("track_temp")
  ambientTemp        Float       @map("ambient_temp")
  durationMin        Int         @map("duration_min")
  wheelLf            Float       @map("wheel_lf")
  wheelRf            Float       @map("wheel_rf")
  wheelLr            Float       @map("wheel_lr")
  wheelRr            Float       @map("wheel_rr")
  targetLf           Float       @map("target_lf")
  targetRf           Float       @map("target_rf")
  targetLr           Float       @map("target_lr")
  targetRr           Float       @map("target_rr")
  resultLf           Float       @map("result_lf")
  resultRf           Float       @map("result_rf")
  resultLr           Float       @map("result_lr")
  resultRr           Float       @map("result_rr")
  refColdLf          Float       @map("ref_cold_lf")
  refColdRf          Float       @map("ref_cold_rf")
  refColdLr          Float       @map("ref_cold_lr")
  refColdRr          Float       @map("ref_cold_rr")
  convertedToRef     Boolean     @default(false) @map("converted_to_ref")
  createdAt          DateTime    @default(now()) @map("created_at")

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track            GripTrack             @relation(fields: [trackId], references: [id])
  referenceSession GripReferenceSession? @relation(fields: [referenceSessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("grip_calculations")
}

model GripDamperScenario {
  scenarioNumber Int     @id @map("scenario_number")
  adjustmentType String  @map("adjustment_type") // rebound_only | two_way
  turnDirection  String  @map("turn_direction") // left | right
  overUnder      String  @map("over_under") // oversteer | understeer
  cornerSegment  String  @map("corner_segment") // braking | turn_in | mid_corner | corner_exit
  cornerSpeed    String  @map("corner_speed") // low | mid | high
  option1        String  @map("option_1")
  option2        String? @map("option_2")
  option3        String? @map("option_3")

  @@unique([adjustmentType, turnDirection, overUnder, cornerSegment, cornerSpeed], map: "grip_damper_scenarios_inputs_key")
  @@map("grip_damper_scenarios")
}

// ─── Setup Sheet ──────────────────────────────────────────────────────────────
// Car setups per session (target vs actual), session notes and change history,
// shared by a team. Shares users and auth with RaceTrace and Finding Grip;
// everything else lives in setup_* tables. Served at /api/setup.
//
// Sheet values are a JSON object of text keyed by parameter, e.g.
// { "lf.rebound": "8", "car.brake_bias": "56.5" }. Values are kept as typed so
// "1 IN" or "Stiff" survive; the client works out numbers and differences.
// Records are owned by the team, not by a person: deleting an account removes
// its memberships and leaves the team's setups in place.

enum SetupRole {
  OWNER
  ENGINEER
  VIEWER
}

enum SetupSessionKind {
  TEST
  PRACTICE
  QUALIFYING
  RACE
  OTHER
}

enum SetupSheetKind {
  TARGET
  ACTUAL
}

enum SetupNoteCategory {
  DRIVER
  ENGINEER
  CHANGE
  GENERAL
}

model SetupTeam {
  id          String   @id @default(cuid())
  name        String
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User?             @relation("SetupTeamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   SetupTeamMember[]
  invites   SetupInvite[]
  cars      SetupCar[]
  events    SetupEvent[]
  sessions  SetupSession[]

  @@index([createdById])
  @@map("setup_teams")
}

model SetupTeamMember {
  teamId    String    @map("team_id")
  userId    String    @map("user_id")
  role      SetupRole @default(ENGINEER)
  createdAt DateTime  @default(now()) @map("created_at")

  team SetupTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("setup_team_members")
}

/// Pending invite by email. Accepted only by an account whose email is verified.
model SetupInvite {
  id          String    @id @default(cuid())
  teamId      String    @map("team_id")
  email       String
  role        SetupRole @default(ENGINEER)
  invitedById String?   @map("invited_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  team      SetupTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("SetupInviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([teamId, email])
  @@index([email])
  @@index([invitedById])
  @@map("setup_invites")
}

model SetupCar {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  name      String
  number    String?
  carClass  String?  @map("car_class")
  /// Reference notes: measurement locations, adjuster legends. { key: text }
  reference Json     @default("{}")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team     SetupTeam      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sessions SetupSession[]

  @@index([teamId])
  @@map("setup_cars")
}

model SetupEvent {
  id        String    @id @default(cuid())
  teamId    String    @map("team_id")
  name      String
  track     String?
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  team     SetupTeam      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sessions SetupSession[]

  @@index([teamId, startDate(sort: Desc)])
  @@map("setup_events")
}

/// One car going out once at an event: P1, Q1, Race 1…
model SetupSession {
  id          String           @id @default(cuid())
  teamId      String           @map("team_id")
  eventId     String           @map("event_id")
  carId       String           @map("car_id")
  name        String
  kind        SetupSessionKind @default(PRACTICE)
  seq         Int              @default(0)
  sessionDate DateTime?        @map("session_date") @db.Date
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  team   SetupTeam          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event  SetupEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  car    SetupCar           @relation(fields: [carId], references: [id], onDelete: Cascade)
  sheets SetupSheet[]
  notes  SetupSessionNote[]

  @@index([eventId, seq])
  @@index([carId])
  @@index([teamId])
  @@map("setup_sessions")
}

/// The target (plan) or actual (measured) setup for a session.
model SetupSheet {
  id          String         @id @default(cuid())
  sessionId   String         @map("session_id")
  kind        SetupSheetKind
  data        Json           @default("{}")
  notes       String?
  updatedById String?        @map("updated_by_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  session   SetupSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  updatedBy User?                @relation("SetupSheetEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  revisions SetupSheetRevision[]

  @@unique([sessionId, kind])
  @@index([updatedById])
  @@map("setup_sheets")
}

/// One save of a sheet: who, when, and each key's old and new value.
/// changes: [{ "key": "lf.rebound", "from": "6", "to": "8" }]
model SetupSheetRevision {
  id           String   @id @default(cuid())
  sheetId      String   @map("sheet_id")
  changes      Json
  notesChanged Boolean  @default(false) @map("notes_changed")
  changedById  String?  @map("changed_by_id")
  changedAt    DateTime @default(now()) @map("changed_at")

  sheet     SetupSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  changedBy User?      @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([sheetId, changedAt(sort: Desc)])
  @@index([changedById])
  @@map("setup_sheet_revisions")
}

/// Driver feedback, engineer notes and planned changes for a session.
model SetupSessionNote {
  id        String            @id @default(cuid())
  sessionId String            @map("session_id")
  authorId  String?           @map("author_id")
  category  SetupNoteCategory @default(GENERAL)
  body      String
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  session SetupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author  User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([authorId])
  @@map("setup_session_notes")
}
