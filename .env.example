# ─── Database ──────────────────────────────────────────────────────────────────
# Default matches docker-compose.yml local Postgres
DATABASE_URL=postgresql://racetrace_dev:devpassword123@localhost:5433/racetrace_dev
DIRECT_URL=postgresql://racetrace_dev:devpassword123@localhost:5433/racetrace_dev

# ─── Auth (required) ─────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-64-char-random-hex-for-access-tokens
JWT_REFRESH_SECRET=change-me-to-64-char-random-hex-for-refresh-tokens
BCRYPT_ROUNDS=12

# ─── Stripe (use sk_test_ / pk_test_ keys for dev) ──────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...              # optional
STRIPE_PRICE_TEAM_ANNUAL=price_...             # optional

# ─── Finding Grip (tire pressure & damper tools, served under /grip) ─────────
# Who can use it: off | admin | testers | public. Defaults to admin.
GRIP_ACCESS=admin
# Comma-separated emails allowed in when GRIP_ACCESS=testers (admins always are).
GRIP_TESTER_EMAILS=
# Finding Grip's own address. Leave unset until that domain is live.
# GRIP_PUBLIC_URL=https://findinggrip.tedderengineering.com
# "free" (default): every tool, no limits, for every account. "paid": Free and Pro plans.
GRIP_PRICING=free
# Stripe price for Finding Grip Pro. Checkout stays off until this is set.
# STRIPE_GRIP_PRO_PRICE_ID=price_...
# The calculation model as one line of JSON. PROPRIETARY: set it only in the
# host's environment settings (Railway). Never commit a real value.
# See docs/FINDING_GRIP.md for the shape. Example with made-up numbers:
# The value may also be base64 of the JSON.
# GRIP_CALC_MODEL={"version":"example","base":"refCold","terms":[{"weight":1,"plus":"targetHot","minus":"refHot"}],"decimals":1}

# ─── Setup Sheet (team car setups, served at /api/setup) ─────────────────────
# Who can use it: off | admin | testers | public. Defaults to admin.
SETUP_ACCESS=admin
# Comma-separated emails allowed in when SETUP_ACCESS=testers (admins always are).
SETUP_TESTER_EMAILS=
# Setup Sheet's address: allowed to call the API, and used for its emails.
# SETUP_PUBLIC_URL=https://setup.tedderengineering.com

# ─── Shared login across the Tedder Engineering sites ────────────────────────
# Set only once the API answers on a host under this domain (api.tedderengineering.com)
# and every site calls it there. Then one login covers RaceTrace, Finding Grip and
# Setup Sheet, and Safari/iPhone keep it. Unset = cookie on the API host (old behaviour).
# COOKIE_DOMAIN=.tedderengineering.com
# Extra browser origins for local work, comma-separated. Ignored in production.
# EXTRA_CORS_ORIGINS=http://localhost:3000

# ─── Stripe (Client / Vite) ─────────────────────────────────────────────────
VITE_STRIPE_PRO_PRICE_ID=price_...
VITE_STRIPE_TEAM_PRICE_ID=price_...

# ─── Supabase (optional for local dev — file storage) ───────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Email (optional — Resend) ──────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@tedderengineering.com

# ─── URLs ────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# ─── Monitoring (optional) ──────────────────────────────────────────────────
SENTRY_DSN=

# ─── General ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
