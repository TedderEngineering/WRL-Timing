{
  "buildCommand": "cd client && npm ci && npx vite build && mv dist/index.html dist/racetrace.html",
  "outputDirectory": "client/dist",
  "installCommand": "echo 'skip'",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://wrl-timing-production.up.railway.app/api/:path*"
    },
    {
      "source": "/r/:path*",
      "missing": [
        {
          "type": "host",
          "value": "findinggrip.tedderengineering.com"
        }
      ],
      "destination": "https://wrl-timing-production.up.railway.app/api/share/r/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "findinggrip.tedderengineering.com"
        }
      ],
      "destination": "/grip.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/racetrace.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://js.stripe.com\"), usb=()" }
      ]
    },
    {
      "source": "/api/live/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    }
  ]
}
